{
  "name": "@karigor/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@karigor/budget": "workspace:*",
    "@karigor/gates": "workspace:*",
    "@karigor/process": "workspace:*",
    "@karigor/profiles": "workspace:*",
    "@karigor/runtime": "workspace:*",
    "@karigor/sandbox": "workspace:*",
    "@karigor/store": "workspace:*",
    "commander": "^13.1.0",
    "zod": "^3.25.76"
  },
  "bin": {
    "karigor": "./dist/bin.js"
  }
}
