{
  "name": "@karigor/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "karigor-server": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@karigor/budget": "workspace:*",
    "@karigor/cli": "workspace:*",
    "@karigor/store": "workspace:*",
    "@karigor/profiles": "workspace:*"
  }
}
